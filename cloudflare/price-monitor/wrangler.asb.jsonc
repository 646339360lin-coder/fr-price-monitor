{
  "$schema": "../../logistics_monitor/node_modules/wrangler/config-schema.json",
  "name": "amazon-asb-price-monitor",
  "main": "src/worker.js",
  "compatibility_date": "2026-05-22",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "asb.price.tentoki.online",
      "custom_domain": true
    },
    {
      "pattern": "asb-price-ingest.tentoki.online",
      "custom_domain": true
    }
  ],
  "vars": {
    "ACCOUNT_KEY": "asb",
    "DASHBOARD_HOST": "asb.price.tentoki.online",
    "INGEST_HOST": "asb-price-ingest.tentoki.online",
    "ALLOWED_EMAILS": "646339360lin@gmail.com,1284609439@qq.com",
    "CATALOG_SOURCE": "WPS AirScript: ASB和XND备货表格-20250730 / 产品清单（ASB欧洲产品）"
  },
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "amazon-eu-price-monitor",
      "database_id": "c627fe04-3a86-4bc7-a306-734477e67054",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SCREENSHOTS",
      "bucket_name": "amazon-price-monitor-screenshots"
    }
  ],
  "observability": {
    "enabled": true
  }
}
